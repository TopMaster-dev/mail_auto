# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# Gmail (IMAP/SMTP)
GMAIL_ADDRESS=contact@rentmagazine.jp
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Claude API
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
SPREADSHEET_ID=your_spreadsheet_id_here

# WordPress REST API (rentmagazine.jp)
WP_BASE_URL=https://rentmagazine.jp
WP_APP_USER=your_wp_username
WP_APP_PASSWORD=your_wp_application_password

# Admin panel
# Generate with: python -m admin.set_password "your-password"
# Paste the output verbatim — surrounding quotes or a stray newline make it unusable.
ADMIN_PASSWORD_HASH=bcrypt_hash_of_admin_password
# REQUIRED. The admin panel refuses to start without it (session forgery).
FLASK_SECRET_KEY=generate_a_random_64char_string_here
# Comma-separated CIDRs. LEAVING THIS EMPTY ALLOWS EVERY IP ADDRESS.
ADMIN_ALLOWED_IPS=123.456.789.0/24
