[Unit]
Description=Mail Automation - admin web panel (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailauto
Group=mailauto
WorkingDirectory=/opt/mail_automation
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mail_automation/venv/bin/gunicorn admin.wsgi:app \
    --bind 127.0.0.1:5000 --workers 2 --timeout 120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
