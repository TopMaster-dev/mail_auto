[Unit]
Description=Mail Automation - inquiry polling and follow-up scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailauto
Group=mailauto
WorkingDirectory=/opt/mail_automation
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mail_automation/venv/bin/python main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
