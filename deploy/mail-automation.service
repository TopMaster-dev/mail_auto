[Unit]
Description=Mail Automation - inquiry polling and follow-up scheduler
After=network-online.target
Wants=network-online.target
# Without a start limit, RestartSec=10 restarts a permanently broken service
# every 10 seconds forever (hammering rentmagazine.jp when WordPress is the
# cause). Give up after 5 attempts in 5 minutes and surface a failed unit.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mailauto
Group=mailauto
WorkingDirectory=/opt/mail_automation
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mail_automation/venv/bin/python main.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
